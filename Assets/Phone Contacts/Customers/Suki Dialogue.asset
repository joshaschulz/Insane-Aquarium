  m_Script: {fileID: 11500000, guid: 4e75c6d8df4549344b5728c761399965, type: 3}
  m_Name: Suki Dialogue
  m_EditorClassIdentifier: 
  contactName: Suki
  dialogueLines:
  - "Fish shop in a bathroom? That\u2019s strange. I\u2019ll be back for more."
  - My mom keeps putting these strange ferns in my fish tank. Do you have something
    that eats plants?
  - I could fit this one in my pocket, right?
  - Freddie likes these ones. He says they have a certain quality about them.
  - Did you see the weird guy in the mask walk by? He looks familiar.
  - "Have you seen Shark Tale? I think you\u2019d like it."
  indexToEnableSelection: 0
