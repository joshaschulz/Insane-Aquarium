  m_Script: {fileID: 11500000, guid: 4e75c6d8df4549344b5728c761399965, type: 3}
  m_Name: Freddie Dialogue
  m_EditorClassIdentifier: 
  contactName: Freddie
  dialogueLines:
  - "Hiya! My name\u2019s Freddie. Are those fish? And you\u2019re selling them?
    AWESOME."
  - "Sooo, what's the most fish you\u2019ll let me buy?"
  - Suki and I are gonna prank our teacher. Give me your fattest fish!
  - "I met this lady on the bus who said she loves these fish. I\u2019m gonna surprise
    her with this."
  - "Do you think glitter and mayonnaise is too hard to clean up? Anyways, I\u2019ll
    take this one."
  - The last guy I bought fish from went out of business. I wonder why.
  indexToEnableSelection: 0
